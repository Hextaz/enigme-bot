# ==============================================================================
# ENIGME BOT - Configuration d'environnement (.env)
# ==============================================================================
# Copiez ce fichier en '.env' (ou '.env.local') et renseignez vos valeurs de test.
# IMPORTANT DEV : Chaque développeur DOIT utiliser son propre bot de test Discord
# et son propre serveur de test pour éviter tout conflit de Gateway WebSocket !
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. IDENTIFIANTS DISCORD DU BOT (Discord Developer Portal)
# ------------------------------------------------------------------------------
# Token secret de votre bot de test (Onglet "Bot" -> "Reset Token")
DISCORD_TOKEN=votre_token_bot_discord_ici

# ID Client de votre application Discord (Onglet "General Information" -> Application ID)
CLIENT_ID=votre_client_id_application_ici

# ID du serveur Discord de test où déployer les commandes slash
GUILD_ID=votre_serveur_discord_test_id_ici

# ------------------------------------------------------------------------------
# 2. SALONS ET RÔLES DU JEU (Sur votre serveur Discord de test)
# ------------------------------------------------------------------------------
# Salon textuel où sont publiées les énigmes quotidiennes à 17h
ENIGMA_CHANNEL_ID=id_salon_enigmes_ici

# Salon textuel où le plateau et les annonces de déplacement s'affichent
BOARD_CHANNEL_ID=id_salon_plateau_ici

# (Optionnel) ID du rôle Discord pingé lors de la sortie d'une énigme
ROLE_ENIGME_ID=id_du_role_a_ping_ici

# ------------------------------------------------------------------------------
# 3. CONTRÔLE D'ACCÈS & MAÎTRE DU JEU (MJ)
# ------------------------------------------------------------------------------
# Votre propre ID utilisateur Discord (pour avoir accès aux commandes /admin)
MJ_USER_ID=votre_user_id_discord_ici

# ------------------------------------------------------------------------------
# 4. MONITORING & SANTÉ (Uptime Kuma - Optionnel en local)
# ------------------------------------------------------------------------------
# URL Push du moniteur Uptime Kuma (laisser vide en dev local)
KUMA_PUSH_URL=
KUMA_PUSH_INTERVAL_SEC=60
KUMA_MAX_FAILURES=3

# ------------------------------------------------------------------------------
# 5. CONSOLE DE LOGS HOMELAB LORDI (Production uniquement)
# ------------------------------------------------------------------------------
DEPLOY_LOGS_TOKEN=ENG_LOGS_token_homelab_ici
DEPLOY_LOGS_URL=https://deploy.hextaz.dev/logs?app=enigme-bot&token=YOUR_TOKEN
